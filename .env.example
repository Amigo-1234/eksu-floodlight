# EKSU Floodlight — copy to .env.local and fill in. Never commit real values.

# Supabase (Project Settings → API). The publishable key is safe in the browser:
# every privilege is enforced by Postgres (RLS + checked functions).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only. Used ONLY by the payment webhook to apply provider-verified payments.
# Leave empty until online payments are approved.
SUPABASE_SECRET_KEY=

# Public base URL of this deployment (used in receipt share links).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Paystack — leave empty: online collection stays disabled until the client
# approves a payment policy AND an owner switches it on in Settings.
PAYSTACK_SECRET_KEY=

# Database tests only: admin URL of a DISPOSABLE PostgreSQL server.
# FLOODLIGHT_TEST_PG=postgres://postgres@127.0.0.1:54329/postgres
